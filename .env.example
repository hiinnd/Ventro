# Development only. Replace all credentials for any shared environment.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

POSTGRES_USER=ventro
POSTGRES_PASSWORD=ventro_local_only
POSTGRES_DB=ventro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ventro:ventro_local_only@127.0.0.1:5432/ventro?schema=public
REDIS_PORT=6379
REDIS_PASSWORD=ventro_redis_local_only
REDIS_URL=redis://:ventro_redis_local_only@127.0.0.1:6379/0
