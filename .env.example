# Development only. Replace all credentials for any shared environment.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Marketing deployment. Keep indexing disabled until the official domain and policies are approved.
SITE_URL=http://127.0.0.1:3000
SEARCH_INDEXING_ENABLED=false
CONTACT_EMAIL=
LEGAL_OPERATOR_NAME=

# env:init generates AUTH_SECRET for local development; use managed secrets in production.
AUTH_SECRET=
AUTH_APP_URL=http://127.0.0.1:3000
AUTH_RATE_NAMESPACE=ventro-auth-v1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ventro.test
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# Optional explicit development-only seed credentials; never seed production.
SEED_EMAIL=
SEED_PASSWORD=

POSTGRES_USER=ventro
POSTGRES_PASSWORD=ventro_local_only
POSTGRES_DB=ventro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ventro:ventro_local_only@127.0.0.1:5432/ventro?schema=public
REDIS_PORT=6379
REDIS_PASSWORD=ventro_redis_local_only
REDIS_URL=redis://:ventro_redis_local_only@127.0.0.1:6379/0
