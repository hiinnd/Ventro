generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  EVENT_MANAGER
  CHECK_IN_STAFF
  PARTICIPANT
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

enum EmailKind {
  VERIFY_EMAIL
  PASSWORD_RESET
  PASSWORD_CHANGED
  ORGANIZATION_INVITE
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventLocationType {
  VENUE
  ONLINE
}

enum EventMediaKind {
  COVER
}

enum FormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  SELECT
  RADIO
  CHECKBOX
  DATE
  CONSENT
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique @db.VarChar(254)
  name              String       @db.VarChar(100)
  passwordHash      String
  locale            String       @default("en") @db.VarChar(2)
  status            UserStatus   @default(ACTIVE)
  platformRole      PlatformRole @default(USER)
  emailVerifiedAt   DateTime?    @db.Timestamptz(3)
  credentialVersion Int          @default(1)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  memberships        OrganizationMember[]
  auditLogs          AuditLog[]
  emailDeliveries    EmailOutbox[]
  sentInvitations    OrganizationInvitation[]
  registrations      Registration[]
}

model Session {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  tokenHash            String        @unique @db.Char(64)
  credentialVersion    Int
  expiresAt            DateTime      @db.Timestamptz(3)
  absoluteExpiresAt    DateTime      @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  renewedAt            DateTime      @default(now()) @db.Timestamptz(3)
  activeOrganizationId String?       @db.Uuid
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeOrganizationId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String                   @db.VarChar(120)
  slug           String                   @unique @db.VarChar(80)
  description    String                   @default("") @db.VarChar(1000)
  website        String                   @default("") @db.VarChar(300)
  contactEmail   String                   @default("") @db.VarChar(254)
  timezone       String                   @default("Asia/Amman") @db.VarChar(80)
  locale         String                   @default("en") @db.VarChar(2)
  archivedAt     DateTime?                @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  members        OrganizationMember[]
  auditLogs      AuditLog[]
  invitations    OrganizationInvitation[]
  activeSessions Session[]
  logo           OrganizationLogo?
  events         Event[]
  eventCategories EventCategory[]
}

model EventCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(80)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events         Event[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model Event {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  categoryId           String?           @db.Uuid
  title                String            @default("") @db.VarChar(180)
  description          String            @default("") @db.VarChar(10000)
  slug                 String            @unique @db.VarChar(120)
  status               EventStatus       @default(DRAFT)
  visibility           EventVisibility   @default(PRIVATE)
  locationType         EventLocationType @default(VENUE)
  venue                String            @default("") @db.VarChar(300)
  onlineUrl            String            @default("") @db.VarChar(500)
  timezone             String            @default("Asia/Amman") @db.VarChar(80)
  startsAt             DateTime?         @db.Timestamptz(3)
  endsAt               DateTime?         @db.Timestamptz(3)
  capacity             Int?
  registrationDeadline DateTime?         @db.Timestamptz(3)
  publishedAt          DateTime?         @db.Timestamptz(3)
  cancelledAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category             EventCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  speakers             EventSpeaker[]
  sessions             EventSession[]
  media                EventMedia[]
  registrationForm     RegistrationForm?
  registrations        Registration[]

  @@index([organizationId, updatedAt])
  @@index([status, visibility, startsAt])
  @@index([categoryId])
}

model RegistrationForm {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @unique @db.Uuid
  status      String      @default("DRAFT") @db.VarChar(16)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields      FormField[]
}

model FormField {
  id                String        @id @default(uuid()) @db.Uuid
  registrationFormId String       @db.Uuid
  key               String        @db.VarChar(64)
  type              FormFieldType
  label             String        @db.VarChar(180)
  helpText          String        @default("") @db.VarChar(500)
  required          Boolean       @default(false)
  options           Json?
  visibilityRule    Json?
  position          Int           @default(0)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  registrationForm  RegistrationForm @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)
  answers           RegistrationAnswer[]

  @@unique([registrationFormId, key])
  @@index([registrationFormId, position])
}

model Registration {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @db.Uuid
  userId      String             @db.Uuid
  status      RegistrationStatus @default(CONFIRMED)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     RegistrationAnswer[]

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@index([eventId, status, createdAt])
}

model RegistrationAnswer {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  formFieldId    String       @db.Uuid
  value          Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  formField      FormField    @relation(fields: [formFieldId], references: [id], onDelete: Restrict)

  @@unique([registrationId, formFieldId])
  @@index([formFieldId])
}

model EventSpeaker {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  name      String   @db.VarChar(120)
  title     String   @default("") @db.VarChar(160)
  bio       String   @default("") @db.VarChar(2000)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions  EventSession[]

  @@index([eventId, position])
}

model EventSession {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  speakerId   String?  @db.Uuid
  title       String   @db.VarChar(180)
  description String   @default("") @db.VarChar(3000)
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker     EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt])
  @@index([speakerId])
}

model EventMedia {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @db.Uuid
  kind      EventMediaKind
  data      Bytes
  mimeType  String         @db.VarChar(80)
  digest    String         @db.Char(64)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, kind])
  @@index([eventId])
}

model OrganizationLogo {
  organizationId String       @id @db.Uuid
  data           Bytes
  digest         String       @db.Char(64)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String           @db.VarChar(254)
  role           OrganizationRole
  tokenHash      String           @unique @db.Char(64)
  status         InvitationStatus @default(PENDING)
  invitedById    String?          @db.Uuid
  expiresAt      DateTime         @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  respondedAt    DateTime?        @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  deliveries     EmailOutbox[]

  @@unique([organizationId, email])
  @@index([email, status, expiresAt])
  @@index([invitedById])
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(PARTICIPANT)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  actorId        String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String        @db.VarChar(64)
  requestId      String?       @db.VarChar(64)
  networkHash    String?       @db.Char(64)
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Transactional outbox keeps email intent durable without storing plaintext tokens in a queue.
model EmailOutbox {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String?                 @db.Uuid
  invitationId     String?                 @db.Uuid
  kind             EmailKind
  encryptedPayload String
  tokenHash        String?                 @db.Char(64)
  status           EmailStatus             @default(PENDING)
  attempts         Int                     @default(0)
  nextAttemptAt    DateTime                @default(now()) @db.Timestamptz(3)
  leaseUntil       DateTime?               @db.Timestamptz(3)
  expiresAt        DateTime                @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  sentAt           DateTime?               @db.Timestamptz(3)
  user             User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation       OrganizationInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([invitationId])
}
